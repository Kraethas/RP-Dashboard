<UserControl x:Class="UnitAlert.UnitAlertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The old key names, redefined against the dashboard's palette. Everything
                     below this line is the standalone window's layout, unchanged. -->
                <ResourceDictionary Source="/UnitAlert;component/Theme/Palette.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="SettingsPanel" Grid.Row="0">

            <TextBlock Text="Default sound (dispatch tone)" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultSoundFileBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         ToolTip="Plays when a matched callsign has no sound of its own." />
                <Button x:Name="DefaultSoundBrowseButton"
                        Grid.Column="2"
                        Content="Browse..."
                        Click="DefaultSoundBrowseButton_Click" />
                <Button x:Name="DefaultSoundTestButton"
                        Grid.Column="4"
                        Content="Test"
                        Click="DefaultSoundTestButton_Click" />
            </Grid>

            <CheckBox x:Name="AfkToggle"
                      Content="Alert on &quot;[AFK CHECK]&quot;"
                      Margin="0,0,0,6"
                      Checked="AfkToggle_Changed"
                      Unchecked="AfkToggle_Changed" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AfkSoundFileBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         ToolTip="Plays when someone flags AFK in chat." />
                <Button x:Name="AfkBrowseButton"
                        Grid.Column="2"
                        Content="Browse..."
                        Click="AfkBrowseButton_Click" />
                <Button x:Name="AfkSoundTestButton"
                        Grid.Column="4"
                        Content="Test"
                        Click="AfkSoundTestButton_Click" />
            </Grid>

            <TextBlock Text="Callsigns" Style="{StaticResource FieldLabel}" />
            <Border Background="{StaticResource FieldBackground}"
                    BorderBrush="{StaticResource FieldBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8"
                    MaxHeight="170">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CallsignsPanel" />
                </ScrollViewer>
            </Border>
            <Button x:Name="AddCallsignButton"
                    Content="+ Add callsign"
                    HorizontalAlignment="Left"
                    Width="140"
                    Margin="0,8,0,14"
                    Click="AddCallsignButton_Click" />

            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="WholeWordCheckBox"
                          Content="Whole word"
                          Margin="0,0,20,0"
                          ToolTip="Stops a callsign like FD-1 from matching inside FD-12."
                          Checked="MatchOption_Changed"
                          Unchecked="MatchOption_Changed" />
                <CheckBox x:Name="RegexModeCheckBox"
                          Content="Regex mode"
                          ToolTip="Treat each callsign as a regular expression instead of plain text."
                          Checked="RegexModeCheckBox_Changed"
                          Unchecked="RegexModeCheckBox_Changed" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="106" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Inactive"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button x:Name="ActivateButton"
                    Grid.Column="2"
                    Content="Activate"
                    Click="ActivateButton_Click" />
        </Grid>

        <TextBlock Grid.Row="4" Text="Recent hits" Style="{StaticResource FieldLabel}" />

        <ListBox x:Name="RecentHitsList" Grid.Row="6"
                 Background="{StaticResource FieldBackground}"
                 BorderBrush="{StaticResource FieldBorder}"
                 BorderThickness="1" />
    </Grid>
</UserControl>
