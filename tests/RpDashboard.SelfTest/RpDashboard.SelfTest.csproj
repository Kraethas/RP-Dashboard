<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Matches the host so it can reference it directly. No test framework, same as Street
         Medic's self-test: this runs from a plain `dotnet run`, which is what keeps it a thing
         you actually run after touching the feed. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RpDashboard.SelfTest</RootNamespace>
    <AssemblyName>RpDashboard.SelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RpDashboard.Host\RpDashboard.Host.csproj"/>
  </ItemGroup>

</Project>
